<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="arm">

  <!-- ================= MATERIAL DEFINITIONS ================= -->
  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="orange">
    <color rgba="1.0 0.5 0.0 1.0"/>
  </material>

  <!-- ================= 1. WORLD / BASE FIXED LINK ================= -->
  <link name="world"/>

  <joint name="virtual_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <material name="grey"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.1" length="0.05"/>
      </geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.005" ixy="0.0" ixz="0.0" iyy="0.005" iyz="0.0" izz="0.01"/>
    </inertial>
  </link>

  <!-- ================= 2. JOINT 1: SHOULDER ROTATION (Yaw) ================= -->
  <link name="shoulder_link">
    <visual>
      <geometry>
        <box size="0.08 0.08 0.1"/>
      </geometry>
      <material name="blue"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <box size="0.08 0.08 0.1"/>
      </geometry>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.8"/>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> 
    <limit lower="-3.14159" upper="3.14159" effort="10.0" velocity="1.5"/>
  </joint>

  <!-- ================= 3. JOINT 2: SHOULDER PITCH ================= -->
  <link name="upper_arm_link">
    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.3"/>
      </geometry>
      <material name="orange"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.3"/>
      </geometry>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <inertia ixx="0.008" ixy="0.0" ixz="0.0" iyy="0.008" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> 
    <limit lower="-1.5707" upper="1.5707" effort="15.0" velocity="1.5"/>
  </joint>

  <!-- ================= 4. JOINT 3 & LINK 3 (Elbow) ================= -->
  <link name="forearm_link">
    <visual>
      <geometry><box size="0.05 0.05 0.2"/></geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.05 0.05 0.2"/></geometry>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.5"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.0" upper="2.0" effort="10.0" velocity="1.5"/>
  </joint>

  <!-- ================= 5. JOINT 4 & LINK 4 (Wrist) ================= -->
  <link name="wrist_link">
    <visual>
      <geometry><box size="0.04 0.04 0.05"/></geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.04 0.04 0.05"/></geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="5.0" velocity="1.5"/>
  </joint>

  <!-- ================= 6. GRIPPER FINGERS (Inertials & Collisions Added) ================= -->
  <link name="left_finger">
    <visual>
      <geometry><box size="0.01 0.01 0.05"/></geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.01 0.01 0.05"/></geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="left_finger_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="left_finger"/>
    <origin xyz="0 0.02 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.03" effort="5.0" velocity="0.5"/>
  </joint>

  <link name="right_finger">
    <visual>
      <geometry><box size="0.01 0.01 0.05"/></geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </visual>
    <collision>
      <geometry><box size="0.01 0.01 0.05"/></geometry>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <inertia ixx="0.00001" ixy="0.0" ixz="0.0" iyy="0.00001" iyz="0.0" izz="0.00001"/>
    </inertial>
  </link>

  <joint name="right_finger_joint" type="prismatic">
    <parent link="wrist_link"/>
    <child link="right_finger"/>
    <origin xyz="0 -0.02 0.05" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/>
    <limit lower="0.0" upper="0.03" effort="5.0" velocity="0.5"/>
  </joint>

<ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    
    <joint name="joint_1">
      <command_interface name="position"><param name="min">-3.1415</param><param name="max">3.1415</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>

    <joint name="joint_2">
      <command_interface name="position"><param name="min">-1.5707</param><param name="max">1.5707</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>

    <joint name="joint_3">
      <command_interface name="position"><param name="min">-2.0</param><param name="max">2.0</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>

    <joint name="joint_4">
      <command_interface name="position"><param name="min">-1.57</param><param name="max">1.57</param></command_interface>
      <state_interface name="position"/><state_interface name="velocity"/>
    </joint>

    <joint name="left_finger_joint">
      <command_interface name="position"><param name="min">0.0</param><param name="max">0.03</param></command_interface>
      <state_interface name="position"/>
    </joint>

    <joint name="right_finger_joint">
      <command_interface name="position"><param name="min">0.0</param><param name="max">0.03</param></command_interface>
      <state_interface name="position"/>
    </joint>
  </ros2_control>

  <!-- ================= MODERN GAZEBO ROS2_CONTROL PLUGIN ================= -->
  <gazebo>
    <plugin filename="libgz_ros2_control-system.so" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find arm)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
